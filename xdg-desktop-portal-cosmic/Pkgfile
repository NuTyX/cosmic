description="A backend implementation for xdg-desktop-portal for the COSMIC desktop environment"
url="https://github.com/pop-os/xdg-desktop-portal-cosmic"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

makedepends=(llvm cosmic-icon-theme libxkbcommon  mesa pipewire rustc just wayland)
run=(xdg-desktop-portal)


name=xdg-desktop-portal-cosmic
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/xdg-desktop-portal-cosmic/archive/refs/tags/epoch-$version.tar.gz)

prepare() {

  cd $name-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  cargo build --release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
