makedepends=(cmake just libheif libxkbcommon  rustc)

description="Image Viewer for the COSMIC™ desktop"
url="https://github.com/pop-os/cosmic-viewer"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-viewer
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"
source=(https://github.com/pop-os/cosmic-viewer/archive/refs/tags/epoch-${version}.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
  sed 's/lto = "fat"/lto = "thin"/' -i Cargo.toml
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
