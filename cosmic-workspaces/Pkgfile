makedepends=(llvm cosmic-icon-theme libinput libxkbcommon mesa rustc wayland)

description="Cosmic workspaces"
url="https://github.com/pop-os/cosmic-workspaces-epoch"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-workspaces
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-workspaces-epoch/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-epoch-$version
  make ARGS+=" --frozen --release"
}

package() {
  cd $name-epoch-epoch-$version
  make prefix=/usr DESTDIR=$PKG install
}
