description="System76 Pop sound theme"
url="https://github.com/pop-os/gtk-theme"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

name=pop-sound-theme
version=5.5.1
release=2

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/gtk-theme/archive/refs/tags/v${version}.tar.gz)

prepare() {
  cd gtk-theme-$version/sounds/src

  sed -e "s,@ThemeName@,Pop," -i index.theme.in
}

build() {
  cd gtk-theme-$version
  install -Dm644 sounds/src/index.theme.in $PKG/usr/share/sounds/Pop/index.theme
  cp -r sounds/src/stereo $PKG/usr/share/sounds/Pop
}
