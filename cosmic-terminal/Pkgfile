description="Cosmic Terminal Emulator"
url="https://github.com/pop-os/cosmic-term"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

makedepends=(cosmic-icon-theme just libxkbcommon rustc wayland)

name=cosmic-terminal
_name=cosmic-term
version=1.11.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-term/archive/refs/tags/epoch-$version.tar.gz
        cosmic-terminal-lto.patch)

prepare() {
  cd $_name-epoch-$version
  patch -Np1 -i ../cosmic-terminal-lto.patch
  cargo fetch --locked
}

build() {
  cd $_name-epoch-$version
  just build-release --frozen
}

package() {
  cd $_name-epoch-$version
  just rootdir=$PKG install
}
