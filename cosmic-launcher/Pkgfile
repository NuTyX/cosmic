makedepends=(llvm cosmic-icon-theme just libxkbcommon  pop-launcher rustc wayland)

description="Layer Shell frontend for Pop launcher"
url="https://github.com/pop-os/cosmic-launcher"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-launcher
version=1.11.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-launcher/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
