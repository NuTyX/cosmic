description="Cosmic App Store"
url="https://github.com/pop-os/cosmic-store"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

makedepends=(cosmic-icon-theme flatpak glib just
             libxkbcommon openssl packagekit rustc
             wayland libidn2 libpsl)


name=cosmic-store
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-store/archive/refs/tags/epoch-$version.tar.gz
        cosmic-store-lto.patch)

prepare() {
  cd $name-epoch-$version
  patch -Np1 -i ../cosmic-store-lto.patch
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
