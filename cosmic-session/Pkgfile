description="Session manager for the COSMIC desktop environment"
url="https://github.com/pop-os/cosmic-session"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

makedepends=(llvm dconf just libxkbcommon rustc)
run=(ttf-opensans xdg-desktop-portal-cosmic noto-fonts mesa
     cosmic-icon-theme cosmic-bg cosmic-applets cosmic-applibrary
     pop-icon-theme cosmic-files cosmic-greeter cosmic-panel
     power-profiles-daemon pop-launcher dart-sass dart-sdk buf
     xorg-xwayland switcheroo-control gtk-update-icon-cache)

name=cosmic-session
version=1.10.0
release=2

PKGMK_KEEP_SOURCES="no"
PKGMK_GROUPS=()

source=(https://github.com/pop-os/cosmic-session/archive/refs/tags/epoch-$version.tar.gz
        cosmic-session-lto.patch)

prepare() {
  cd $name-epoch-$version
  patch -Np1 -i ../cosmic-session-lto.patch
  cargo fetch --locked
  sed -i 's/libexec/lib/g' Justfile src/main.rs
}

build() {
  cd $name-epoch-$version
  cargo build --release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
