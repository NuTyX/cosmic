description="Utility for capturing screenshots via XDG Desktop Portal"
url="https://github.com/pop-os/cosmic-screenshot"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

makedepends=(cosmic-icon-theme just libxkbcommon rustc xdg-desktop-portal-cosmic)

name=cosmic-screenshot
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-screenshot/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
