description="The settings application for the COSMIC desktop environment"
url="https://github.com/pop-os/cosmic-settings"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

makedepends=(llvm cosmic-randr just libinput libxkbcommon
  networkmanager power-profiles-daemon pulseaudio pipewire
  rustc systemd wayland xorg-fontconfig dav1d)

run=(pop-icon-theme pop-sound-theme cosmic-icon-theme adw-gtk-theme
     network-manager-applet accountsservice iso-codes ttf-opensans)


name=cosmic-settings
version=1.11.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-settings/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
