makedepends=(cosmic-icon-theme glib just libxkbcommon rustc wayland)

description="Text editor for the COSMIC desktop"
url="https://github.com/pop-os/cosmic-edit"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-text-editor
_name=cosmic-edit
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-edit/archive/refs/tags/epoch-$version.tar.gz
        cosmic-text-editor-lto.patch)

prepare() {
cd $_name-epoch-$version
  patch -Np1 -i ../cosmic-text-editor-lto.patch
  cargo fetch --locked
}

build() {
  cd $_name-epoch-$version
  just build-release --frozen
}

package() {
  cd $_name-epoch-$version
  just rootdir=$PKG install
}
