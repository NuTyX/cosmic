description="COSMIC On-Screen Display"
url="https://github.com/pop-os/cosmic-osd"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)
makedepends=(llvm just libinput libxkbcommon pipewire pulseaudio rustc
             sound-theme-freedesktop systemd wayland)

name=cosmic-osd
version=1.11.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-osd/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just polkit-agent-helper-1="/usr/lib/polkit-1/polkit-agent-helper-1" build-release
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
