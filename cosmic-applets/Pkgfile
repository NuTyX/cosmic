description="Applets for COSMIC Panel"
url="https://github.com/pop-os/cosmic-applets"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)
makedepends=(llvm just libinput libxkbcommon
             rustc systemd)
run=(cosmic-icon-theme pipewire pulseaudio gtk-update-icon-cache)
name=cosmic-applets
version=1.11.0
release=1

PKGMK_KEEP_SOURCES="no"
PKGMK_GROUPS=()

source=(https://github.com/pop-os/cosmic-applets/archive/refs/tags/epoch-${version}.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
  sed 's/lto = "fat"/lto = "thin"/' -i Cargo.toml
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
