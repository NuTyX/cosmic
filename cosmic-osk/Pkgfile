makedepends=(llvm git just libxkbcommon  rustc systemd)

description="COSMIC On-Screen Keyboard"
url="https://github.com/pop-os/cosmic-osk"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-osk
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-osk/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
