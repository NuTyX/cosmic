description="System Monitor for the COSMIC™ desktop"
url="https://github.com/pop-os/cosmic-monitor"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)
makedepends=(cosmic-icon-theme just libinput libxkbcommon rustc systemd)

name=cosmic-monitor
version=1.11.0
release=1

PKGMK_KEEP_SOURCES="no"
source=(https://github.com/pop-os/cosmic-monitor/archive/refs/tags/epoch-${version}.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
  sed 's/lto = "fat"/lto = "thin"/' -i Cargo.toml
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
