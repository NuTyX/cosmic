makedepends=(llvm cosmic-icon-theme just libxkbcommon  rustc wayland)

description="Layer Shell notifications daemon which integrates with COSMIC"
url="https://github.com/pop-os/cosmic-notifications"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-notifications
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-notifications/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
