description="Cosmic settings daemon"
url="https://github.com/pop-os/cosmic-settings-daemon"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

makedepends=(llvm acpid just alsa-utils geoclue2 libinput libxkbcommon
             playerctl pipewire pulseaudio rustc systemd)
run=(xdg-utils adw-gtk-theme cosmic-sound-theme)

name=cosmic-settings-daemon
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-settings-daemon/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
  sed 's/sudo/wheel/g' -i data/polkit-1/rules.d/cosmic-settings-daemon.rules
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
