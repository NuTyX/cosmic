makedepends=(llvm just libxkbcommon rustc wayland)

description="XDG Shell Wrapper Panel for Cosmic"
url="https://github.com/pop-os/cosmic-panel"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-panel
version=1.11.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-panel/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
