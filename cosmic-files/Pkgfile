makedepends=(llvm cosmic-icon-theme glib gvfs just libxkbcommon  rustc xdg-utils)

description="File manager for the COSMIC desktop environment"
url="https://github.com/pop-os/cosmic-files"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-files
version=1.11.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-files/archive/refs/tags/epoch-$version.tar.gz
        cosmic-files-lto.patch)

prepare() {
  cd $name-epoch-$version
  patch -Np1 -i ../cosmic-files-lto.patch
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  CC=clang just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
