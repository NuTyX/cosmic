makedepends=(llvm cosmic-icon-theme just libxkbcommon rustc dav1d)

description="COSMIC session service which applies backgrounds to displays"
url="https://github.com/pop-os/cosmic-bg"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-bg
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-bg/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
