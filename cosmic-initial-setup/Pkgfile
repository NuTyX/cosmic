description="Cosmic Initial Setup"
url="https://github.com/pop-os/cosmic-initial-setup"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)
makedepends=(cosmic-icon-theme just libinput libxkbcommon polkit pulseaudio rustc systemd)

name=cosmic-initial-setup
version=1.10.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-initial-setup/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
  cargo fetch --locked --target "$(rustc --print host-tuple)"
}

build() {
  cd $name-epoch-$version
  just build-release
  just rootdir=$PKG install
}
