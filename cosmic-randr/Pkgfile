makedepends=(llvm just rustc wayland)

description="Library and utility for displaying and configuring Wayland outputs"
url="https://github.com/pop-os/cosmic-randr"

packager="tnut <tnut@nutyx.org>"
contributors="Great-OS Team"

set=(cosmic)

name=cosmic-randr
version=1.11.0
release=1

PKGMK_KEEP_SOURCES="no"

source=(https://github.com/pop-os/cosmic-randr/archive/refs/tags/epoch-$version.tar.gz)

prepare() {
  cd $name-epoch-$version
#  patch -Np1 -i ../cosmic-randr-lto.patch
  cargo fetch --locked
}

build() {
  cd $name-epoch-$version
  just build-release --frozen
}

package() {
  cd $name-epoch-$version
  just rootdir=$PKG install
}
